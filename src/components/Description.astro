---
import SkillsSection from './SkillsSection.astro';

const photos = [
    {
        src: "sparkhacks2025.JPG",
        alt: "Working for SparkHacks",
        caption: "Working for SparkHacks",
        colorTheme: "purple" as const
    },
    {
        src: "wildhacks2025.jpg",
        alt: "My hackathon win at WildHacks 2025",
        caption: "My hackathon win @ WildHacks 2025!",
        colorTheme: "pink" as const
    },
    {
        src: "hackillinois2025.JPG",
        alt: "Testing at 5AM during HackIllinois",
        caption: "Testing at 5AM during HackIllinois",
        colorTheme: "blue" as const
    }
];
---
<div class="min-h-screen flex items-center justify-center px-4 md:px-6 lg:px-12">
    <div class="max-w-6xl mx-auto text-center">
        <div class="space-y-8 md:space-y-16">
            <!-- About Me -->
            <h2 class="text-4xl md:text-6xl font-bold text-white font-dancing m-6 md:m-12">About Me</h2>
            
            <div class="space-y-4 md:space-y-6">
                <div class="max-w-5xl mx-auto">
                    <p class="text-lg md:text-2xl text-gray-200 leading-relaxed text-center pb-3 md:pb-5">
                        I'm Nathan, a Computer Science senior at the University of Illinois Chicago.
                        Graduating in May 2026, I'm currently looking for <span class="text-red-400 font-semibold">SWE Summer 2026 Internships/Full-time roles!</span>
                    </p>
                    <p class="text-lg md:text-2xl text-gray-200 leading-relaxed text-center pb-3 md:pb-5">
                        I'm currently a <span class="text-blue-400 font-semibold">Teaching Assistant</span> for UIC's Data Structures class, where I love helping others grow their skills and passion for coding. 
                        I'm also serving as SparkHacks' 2026 <span class="text-blue-400 font-semibold">Web Development Lead</span>, leading the design and development of the hackathon's website and dashboard system.
                    </p>
                    <p class="text-lg md:text-2xl text-gray-200 leading-relaxed text-center pb-3 md:pb-5">
                        I've also enjoyed participating in hackathons the past year, with my most recent achievement being <span class="text-yellow-400 font-semibold">victorious</span> at Northwestern's <span class="text-green-400 font-semibold">WildHacks 2025</span>!
                    </p>
                </div>
            </div>

            <!-- Photos -->
            <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-6 lg:gap-8">
                <div class="photo-frame photo-frame-purple w-64 md:w-48 lg:w-64">
                    <div class="aspect-[3/4] w-full glass rounded-2xl shadow-xl overflow-hidden">
                        <img src="sparkhacks2025.JPG" class="w-full h-full object-cover rounded-lg" alt="Working for SparkHacks">
                    </div>
                    <p class="text-center text-gray-300 text-xs md:text-sm italic mt-2">Working for SparkHacks</p>
                </div>

                <div class="photo-frame photo-frame-pink w-96 md:w-[24rem] lg:w-[32rem]">
                    <div class="aspect-[4/3] w-full glass rounded-2xl shadow-xl overflow-hidden">
                        <img src="wildhacks2025.jpg" class="w-full h-full object-cover rounded-lg" alt="My hackathon win at WildHacks 2025">
                    </div>
                    <p class="text-center text-gray-300 text-xs md:text-sm italic mt-2">My hackathon win @ WildHacks 2025!</p>
                </div>

                <div class="photo-frame photo-frame-blue w-64 md:w-48 lg:w-64">
                    <div class="aspect-[3/4] w-full glass rounded-2xl shadow-xl overflow-hidden">
                        <img src="hackillinois2025.JPG" class="w-full h-full object-cover rounded-lg" alt="Testing at 5AM during HackIllinois">
                    </div>
                    <p class="text-center text-gray-300 text-xs md:text-sm italic mt-2">Testing at 5AM during HackIllinois</p>
                </div>
            </div>

            <div class="space-y-4 md:space-y-6">
                <div class="max-w-5xl mx-auto">
                    <p class="text-lg md:text-2xl text-gray-200 leading-relaxed text-center p-3 md:p-5">
                        I'm passionate about <span class="text-green-300 font-semibold">software engineering</span>, <span class="text-red-300 font-semibold">AI</span>, and <span class="text-blue-300 font-semibold">full-stack/web development</span>. 
                        I enjoy using technology to create meaningful impact, whether by building personal projects, contributing to teams around my communities, or leveraging the potential of AI and machine learning.
                    </p>
                    <p class="text-lg md:text-2xl text-gray-200 leading-relaxed text-center">
                        I'm always looking for opportunities, such as internships, research, or collaborative projects, where I can keep growing, building, and making positive impact through tech.
                    </p>
                </div>
            </div>

            <SkillsSection />

            <div class="mt-8 md:mt-16 space-y-4 md:space-y-6 pb-5">
                <p class="text-lg md:text-xl lg:text-2xl text-gray-200">Take a look at my projects, my experience, or my leadership and activities!</p>
                <div class="flex flex-col sm:flex-row gap-3 md:gap-4 justify-center items-center">
                    <a href="/projects" class="w-full sm:w-auto btn-hover-effect border-2 rounded-2xl px-6 py-3 md:px-8 md:py-4 border-purple-400 text-purple-300 hover:text-white hover:bg-purple-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-500/25 text-base md:text-lg">
                        Projects
                    </a>
                    <a href="/experience" class="w-full sm:w-auto btn-hover-effect border-2 rounded-2xl px-6 py-3 md:px-8 md:py-4 border-blue-400 text-blue-300 hover:text-white hover:bg-blue-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-500/25 text-base md:text-lg">
                        Experience
                    </a>
                    <a href="/leadership" class="w-full sm:w-auto btn-hover-effect border-2 rounded-2xl px-6 py-3 md:px-8 md:py-4 border-green-400 text-green-300 hover:text-white hover:bg-green-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-500/25 text-base md:text-lg">
                        Leadership
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>