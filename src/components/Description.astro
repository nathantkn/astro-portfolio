                            <div class="flex flex-wrap gap-2 justify-center">
                                <span class="px-3 py-1 bg-cyan-500/30 text-cyan-200 rounded-full text-sm border border-cyan-400/40">React</span>
                                <span class="px-3 py-1 bg-green-500/30 text-green-200 rounded-full text-sm border border-green-400/40">Node.js</span>
                                <span class="px-3 py-1 bg-orange-500/30 text-orange-200 rounded-full text-sm border border-orange-400/40">Next.js</span>
                                <span class="px-3 py-1 bg-purple-500/30 text-purple-200 rounded-full text-sm border border-purple-400/40">Vite</span>
                                <span class="px-3 py-1 bg-yellow-500/30 text-yellow-200 rounded-full text-sm border border-yellow-400/40">Yii</span>
                                <span class="px-3 py-1 bg-blue-500/30 text-blue-200 rounded-full text-sm border border-blue-400/40">Spring</span>
                                <span class="px-3 py-1 bg-gray-500/30 text-gray-200 rounded-full text-sm border border-gray-400/40">Flask</span>
                                <span class="px-3 py-1 bg-red-500/30 text-red-200 rounded-full text-sm border border-red-400/40">Flutter</span>
                                <span class="px-3 py-1 bg-purple-500/30 text-purple-200 rounded-full text-sm border border-purple-400/40">Bootstrap</span>
                            </div>
                        </div>
                        <div class="space-y-3">
                            <h4 class="text-lg font-semibold text-pink-300">Technologies</h4>
                            <div class="flex flex-wrap gap-2 justify-center">
                                <span class="px-3 py-1 bg-pink-500/30 text-pink-200 rounded-full text-sm border border-pink-400/40">HTML/CSS</span>
                                <span class="px-3 py-1 bg-indigo-500/30 text-indigo-200 rounded-full text-sm border border-indigo-400/40">Nginx</span>
                                <span class="px-3 py-1 bg-teal-500/30 text-teal-200 rounded-full text-sm border border-teal-400/40">RESTful APIs</span>
                                <span class="px-3 py-1 bg-red-500/30 text-red-200 rounded-full text-sm border border-red-400/40">JWT</span>
