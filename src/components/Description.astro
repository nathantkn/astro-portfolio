---
// Updated Introduction component with cursive font
---

<div class="min-h-screen flex items-center justify-center px-6 md:px-12">
    <div class="max-w-4xl mx-auto text-center">
        <div class="space-y-8">
            <!-- About Section -->
            <div class="space-y-6">
                <h2 class="text-4xl md:text-6xl font-bold text-white font-poppins mb-8">About Me</h2>
                <div class="grid md:grid-cols-2 gap-8 items-center">
                    <div class="space-y-4 text-left">
                        <p class="text-lg md:text-xl text-gray-200 leading-relaxed">
                            I'm a passionate software developer with a love for creating innovative solutions and beautiful user experiences. 
                            My journey in technology has led me to explore various domains from web development to machine learning.
                        </p>
                        <p class="text-lg md:text-xl text-gray-200 leading-relaxed">
                            When I'm not coding, you can find me exploring new technologies, contributing to open-source projects, 
                            or sharing knowledge with the developer community.
                        </p>
                    </div>
                    <div class="space-y-4">
                        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 shadow-xl">
                            <h3 class="text-xl font-semibold text-white mb-4">Skills & Interests</h3>
                            <div class="flex flex-wrap gap-2">
                                <span class="px-3 py-1 bg-purple-500/30 text-purple-200 rounded-full text-sm border border-purple-400/40">JavaScript</span>
                                <span class="px-3 py-1 bg-blue-500/30 text-blue-200 rounded-full text-sm border border-blue-400/40">React</span>
                                <span class="px-3 py-1 bg-green-500/30 text-green-200 rounded-full text-sm border border-green-400/40">Node.js</span>
                                <span class="px-3 py-1 bg-yellow-500/30 text-yellow-200 rounded-full text-sm border border-yellow-400/40">Python</span>
                                <span class="px-3 py-1 bg-pink-500/30 text-pink-200 rounded-full text-sm border border-pink-400/40">Machine Learning</span>
                                <span class="px-3 py-1 bg-indigo-500/30 text-indigo-200 rounded-full text-sm border border-indigo-400/40">UI/UX Design</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 hover:bg-white/15 transition-all duration-300 hover:-translate-y-1 shadow-xl">
                    <div class="text-3xl font-bold text-purple-300 mb-2">5+</div>
                    <div class="text-gray-200">Years Experience</div>
                </div>
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 hover:bg-white/15 transition-all duration-300 hover:-translate-y-1 shadow-xl">
                    <div class="text-3xl font-bold text-blue-300 mb-2">20+</div>
                    <div class="text-gray-200">Projects Completed</div>
                </div>
                <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 hover:bg-white/15 transition-all duration-300 hover:-translate-y-1 shadow-xl">
                    <div class="text-3xl font-bold text-pink-300 mb-2">∞</div>
                    <div class="text-gray-200">Coffee Consumed</div>
                </div>
            </div>

            <!-- Call to Action -->
            <div class="mt-12 space-y-4">
                <p class="text-xl text-gray-200">Let's build something amazing together!</p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                    <a href="/projects" class="border-2 rounded-2xl px-6 py-3 border-purple-400 text-purple-300 hover:text-white hover:bg-purple-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-500/25">
                        View My Work
                    </a>
                    <a href="/experience" class="border-2 rounded-2xl px-6 py-3 border-blue-400 text-blue-300 hover:text-white hover:bg-blue-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-500/25">
                        My Experience
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>