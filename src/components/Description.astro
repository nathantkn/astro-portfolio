                    <a href="/experience" class="border-2 rounded-2xl px-8 py-4 border-blue-400 text-blue-300 hover:text-white hover:bg-blue-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-500/25 text-lg">
