                                <span class="px-3 py-1 bg-blue-500/30 text-blue-200 rounded-full text-sm border border-blue-400/40">C/C++</span>
                                <span class="px-3 py-1 bg-green-500/30 text-green-200 rounded-full text-sm border border-green-400/40">Java</span>
                                <span class="px-3 py-1 bg-yellow-500/30 text-yellow-200 rounded-full text-sm border border-yellow-400/40">JavaScript</span>
                                <span class="px-3 py-1 bg-red-500/30 text-red-200 rounded-full text-sm border border-red-400/40">SQL</span>
                                <span class="px-3 py-1 bg-gray-500/30 text-gray-200 rounded-full text-sm border border-gray-400/40">Dart</span>
