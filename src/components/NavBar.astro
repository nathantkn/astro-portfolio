---
const links = [
  { name: "About", href: "/" },
  { name: "Projects", href: "/projects" },
  { name: "Experience", href: "/experience" },
  { name: "Updates", href: "/updates" },
];
---

<nav class="fixed top-4 z-50">
  <div class="flex justify-end">
    <div class="hidden md:flex gap-4 text-poppins text-dark-red border px-4 py-1 rounded-2xl backdrop-blur-md bg-snowhite/30">
      {links.map(link => (
        <a href={link.href} class="hover:text-gray-500">{link.name}</a>
      ))}
    </div>
  </div>
</nav>
