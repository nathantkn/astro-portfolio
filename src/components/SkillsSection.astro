---
import SkillBadge from './SkillBadge.astro';

const skillCategories = [
    {
        title: "Languages",
        titleColor: "text-purple-300",
        skills: [
            "Python",
            "C/C++", 
            "Java",
            "JavaScript",
            "TypeScript",
            "SQL",
            "Dart",
            "PHP",
        ]
    },
    {
        title: "Frameworks",
        titleColor: "text-blue-300",
        skills: [
            "React",
            "Node.js",
            "Next.js",
            "Vite",
            "Yii",
            "Spring",
            "Flask",
            "Flutter",
            "Bootstrap",
            "Tailwind",
            "Jest",
            "Maven"
        ]
    },
    {
        title: "Technologies",
        titleColor: "text-pink-300",
        skills: [
            "HTML/CSS",
            "Nginx",
            "RESTful APIs",
            "JWT",
            "OAuth",
            "MariaDB",
            "SQLite",
            "MySQL",
            "Firebase",
            "Supabase",
            "Postman"
        ]
    }
];

---
<div class="mt-16">
    <div class="glass py-12 pr-3 shadow-xl">
        <h3 class="text-2xl font-bold text-white mb-6 text-center">Technical Skills</h3>
        <div class="grid md:grid-cols-3 gap-6">
            {skillCategories.map((category) => (
                <div class="space-y-3">
                    <h4 class={`text-lg font-semibold ${category.titleColor}`}>{category.title}</h4>
                    <div class="flex flex-wrap gap-2 justify-center">
                        {category.skills.map((skill) => (
                            <SkillBadge skill={skill} />
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </div>
</div>