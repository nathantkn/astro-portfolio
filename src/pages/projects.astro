---
import "../styles/global.css";
import Layout from '../layouts/Layout.astro';
import SkillBadge from '../components/SkillBadge.astro';
import { Icon } from 'astro-icon/components'

const projects = [
  {
    title: "Haven",
    endDate: "April 2025",
    website: "https://devpost.com/software/haven-kj3o4q",
    repo: "https://github.com/Ayush7970/wildhacks_2026",
    tags: ["TypeScript", "Next", "Python", "OAuth", "TensorFlow.js"],
    img: "/projects/haven.png",
    desc: "A neurodivergent-focused wellness and productivity app. Haven helps people with sensory processing differences navigate daily life through smarter scheduling, focus tools, sensory-aware place ratings, and environment sensing. First place for WildHacks 2026.",
  },
  {
      title: "SparkHacks 2026 Website",
      startDate: "August 2025",
      endDate: "February 2026",
      website: "https://www.sparkhacks.org/",
      repo: "https://github.com/SparkHacks/spark-web-2026",
      tags: ["Astro", "TypeScript", "Tailwind"],
      img: "/projects/sparkhacks.png",
      desc: "The flagship website for SparkHacks 2026. Built by UIC students, for UIC students. Lights, cameras, hacktion!",
  },
  {
      title: "SparkHacks 2026 Dashboard",
      startDate: "August 2025",
      endDate: "February 2026",
      website: "https://dashboard.sparkhacks.org/",
      repo: "https://github.com/SparkHacks/spark-dashboard",
      tags: ["Astro", "TypeScript", "Firebase", "Tailwind"],
      img: "/projects/dashboard.png",
      desc: "The user/admin dashboard for SparkHacks 2026. Used for managing applications, scanning QR codes, and changing permissions.",
  },
  {
    title: "Mystery AI",
    startDate: "October 2025",
    endDate: "April 2026",
    website: "https://ai-privacy-literacy.vercel.app/",
    repo: "https://github.com/nsoniuic/AI-Privacy-Literacy-Fall-2025",
    tags: ["React", "Node.js", "JavaScript"],
    img: "/projects/mystery_ai.png",
    desc: "An interactive educational web application designed to teach children about AI reasoning, pattern recognition, and digital privacy through engaging puzzles and scenarios.",
  },
  {
    title: "Outloop AI",
    endDate: "March 2026",
    website: "https://devpost.com/software/chicago-team",
    repo: "https://github.com/YamaanNandolia/Outloop-AI",
    tags: ["Jac", "TypeScript", "Python"],
    img: "/projects/outloop.png",
    desc: "An autonomous startup builder that analyzes trends from around the world, extrapolates problem statements, and autonomously builds software products to address those problems. It also simultaneously handles the business development and customer outreach.",
  },
  {
    title: "Schedly",
    startDate: "October 2025",
    endDate: "December 2025",
    website: "https://schedly-gtxg.onrender.com/",
    repo: "https://github.com/mqbal/CS484_Final",
    tags: ["Next.js", "React", "TypeScript", "OAuth"],
    img: "/projects/schedly.png",
    desc: "Upload your course syllabi and let AI extract assignments and exam dates. Sync everything to Google Calendar, and never miss a deadline again.",
  },
  {
    title: "Restockd",
    startDate: "September 2025",
    endDate: "December 2025",
    website: "https://restockd-ten.vercel.app/",
    repo: "https://github.com/TheRoadSurgeon/CS351-GroupProject",
    tags: ["React", "Flask", "PostgreSQL"],
    img: "/projects/restockd.png",
    desc: "Streamlines coordination between food donors and food banks in real-time. Enables food banks to post donation needs, donors to discover nearby opportunities, and both parties to schedule seamless pickups and drop-offs.",
  },
  {
    title: "Dynamic Bill Splitter",
    endDate: "October 2025",
    website: "https://dynamic-bill-splitter.vercel.app/",
    repo: "https://github.com/nathantkn/astro-bill-splitter",
    tags: ["Astro", "TypeScript", "Vite", "Spline"],
    img: "/projects/bill_splitter.png",
    desc: "Allows parties to split dining and grocery bills, based on the number of people and the items they bought or shared. Created for my own personal use for nights out with friends.",
  },
  {
    title: "Music Ranker",
    startDate: "May 2025",
    endDate: "February 2026",
    website: "https://music-rank-5wfy.onrender.com",
    repo: "https://github.com/nathantkn/music-rank",
    tags: ["React", "Node.js", "Express", "PostgreSQL"],
    img: "/projects/music_ranker.png",
    desc: "Allows users to rank their favorite music tracks and discover new ones based on their preferences.",
  },
  {
    title: "TARIFFARM",
    endDate: "March 2025",
    website: "https://devpost.com/software/idk-yet-o67hj8",
    repo: "https://github.com/nathantkn/tariffarm",
    tags: ["Python", "React", "Next.js"],
    img: "/projects/tariffarm.jpg",
    desc: "Allows users to calculate and visualize the full cost of importing commodities into the US. Third place winner for WildHacks 2025.",
  },
  {
    title: "Baldur: Debris Detection and Removal",
    endDate: "February 2025",
    website: "https://devpost.com/software/baldur-8h2tmn",
    repo: "https://github.com/nathantkn/Baldur-HackIllinois",
    tags: ["Python", "OpenCV", "Flutter", "Dart", "Raspberry Pi"],
    img: "/projects/baldur.jpg",
    desc: "An autonomous, AI-powered solution to detect and remove debris from fields using a Raspberry Pi-controlled vehicle equipped with a robotic claw. Submission for HackIllinois 2025.",
  },
];
---

<Layout title="Projects">
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-gray-800 to-slate-800 text-white">
    <div class="container mx-auto px-4 py-16 max-w-8xl">
      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-sky-400 font-bold font-dancing text-6xl md:text-8xl lg:text-9xl mb-4 bg-gradient-to-r from-sky-400 to-blue-500 bg-clip-text text-transparent">
          Projects
        </h1>
        <div class="w-60 h-1 bg-gradient-to-r from-sky-500 to-blue-600 mx-auto rounded-full"></div>
      </div>

      <!-- Projects Grid -->
      <div class="grid lg:grid-cols-3 gap-12">
        {projects.map((project, index) => (
          <div class="featured-project rounded-2xl p-8 animate-fade-in h-full flex flex-col" style={`animation-delay: ${index * 0.2}s`}>
            <div class="flex flex-col gap-6 h-full">
              <!-- Project Header -->
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h2 class="text-2xl lg:text-3xl font-bold text-white hover:text-sky-400 transition-colors duration-300">
                    {project.title}
                  </h2>
                  <p class="text-gray-400 text-sm mt-2">
                    {project.startDate ? `${project.startDate} - ${project.endDate}` : project.endDate}
                  </p>
                </div>
                <span class="flex gap-2">
                  <a href={project.website} class="project-link text-sky-400 hover:text-sky-300 text-3xl" target="_blank" rel="noopener noreferrer">
                    <Icon name="tab" />
                  </a>
                  <a href={project.repo} class="project-link text-sky-400 hover:text-sky-300 text-3xl" target="_blank" rel="noopener noreferrer">
                    <Icon name="github" />
                  </a>
                </span>
              </div>
              
              <!-- Project Image -->
              {project.img && (
                  <img src={project.img} alt={project.title} class="w-full aspect-[16/10] object-cover rounded-xl shadow-2xl" />
              )}
              
              <!-- Project Description -->
              <p class="text-gray-300 text-lg leading-relaxed flex-grow">
                {project.desc}
              </p>
              
              <!-- Project Tags using SkillBadge component -->
              <div class="flex gap-3 flex-wrap mt-auto">
                {project.tags.map((tag) => (
                  <SkillBadge skill={tag} />
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .font-dancing {
      background-size: 200% 200%;
      animation: gradient-shift 3s ease-in-out infinite;
    }
    
    @keyframes gradient-shift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    .featured-project {
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 41, 59, 0.7) 100%);
      backdrop-filter: blur(15px);
      border: 1px solid rgba(148, 163, 184, 0.2);
      transition: all 0.3s ease;
    }

    .featured-project:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4), 0 0 40px rgba(56, 189, 248, 0.15);
      border-color: rgba(56, 189, 248, 0.4);
    }

    .project-link {
      transition: all 0.2s ease;
    }

    .project-link:hover {
      transform: scale(1.1);
      filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.5));
    }

    @keyframes fade-in-up {
      from {
        opacity: 0;
        transform: translateY(40px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in {
      animation: fade-in-up 0.8s ease-out both;
    }
  </style>
</Layout>